    "rules": [
      { "name": "The One Green Rule", "body": "Signal Green marks numerals, counters, rules and focus; never body text and never large fills outside the CTA band or button.", "section": "colors" },
      { "name": "The Drenched Hero Rule", "body": "Petrol-to-teal appears as a gradient only in the hero and the feature tile; flat Deep Petrol is used for the stat band and contact.", "section": "colors" },
      { "name": "The Tabular Facts Rule", "body": "Hours, registrations and stats use tabular numerals.", "section": "typography" },
      { "name": "The Soft Lift Rule", "body": "Shadows are negative-spread and neutral; they never offset hard and never tint.", "section": "elevation" }
    ],
    "dos": [
      "Do keep every portrait at 4:5 (or the arch frame) with object-position near the top (12 to 20%) so faces are never cropped.",
      "Do use Deep Petrol for flat dark sections and the 125deg Deep/Brand/Teal gradient only for the hero.",
      "Do keep touch targets at 44px or more and body copy at 17px or more for the older-reader audience.",
      "Do show registration next to every doctor's name.",
      "Do gate hover motion on (hover:hover) and honor prefers-reduced-motion."
